# Copy this file to .env.local and add values from your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=

# New projects use a publishable key. Legacy projects can use the anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. Never rename this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Used only by scripts/seed-local-admin.mjs; never commit local values.
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=

# Optional, local-only shared password for scripts/seed-local-demo.mjs.
LOCAL_DEMO_PASSWORD=
